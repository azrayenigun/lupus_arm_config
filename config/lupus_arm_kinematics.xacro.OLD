  <link name="Gripper_Joint_1_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="1E-06" ixy="0" ixz="0"
               iyy="1E-06" iyz="0"
               izz="1E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arc_rover_autonomy/meshes/Gripper_Joint_1_Link.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <!-- B4: Gripper collision için basit kutu (mesh yerine) - performance için -->
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.025 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="Gripper_Joint_2_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="1E-06" ixy="0" ixz="0"
               iyy="1E-06" iyz="0"
               izz="1E-06" />
    </inertial>
