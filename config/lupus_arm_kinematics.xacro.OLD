              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="Joint_4_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1E-05" ixy="0" ixz="0"
               iyy="1E-05" iyz="0"
               izz="1E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
