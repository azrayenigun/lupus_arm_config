      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.025 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- EKLEMLER (JOINTS)                                             -->
  <!-- ============================================================ -->

  <joint name="Joint_1" type="revolute">
    <origin xyz="0 0 0.075" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Joint_1_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="40" velocity="10.5" />
  </joint>

  <joint name="Joint_2" type="revolute">
    <origin xyz="0 0 0.075" rpy="-1.5708 0 0" />
    <parent link="Joint_1_Link" />
    <child link="Joint_2_Link" />
    <axis xyz="0 0 1" />
    <!-- B7: Joint_2 limitleri daraltıldı (kol kendine çarpmasın) -->
    <limit lower="-2.0" upper="2.0" effort="300" velocity="0.8" />
  </joint>

  <joint name="Joint_3" type="revolute">
    <origin xyz="0 0.35 0" rpy="0 0 0" />
    <parent link="Joint_2_Link" />
    <child link="Joint_3_Link" />
    <axis xyz="0 0 1" />
    <!-- B7: Joint_3 limitleri daraltıldı -->
    <limit lower="-2.0" upper="2.0" effort="300" velocity="0.8" />
  </joint>

  <joint name="Joint_4" type="revolute">
    <origin xyz="0 0.33 -0.025" rpy="-1.5708 0 0" />
    <parent link="Joint_3_Link" />
    <child link="Joint_4_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="6" velocity="3.5" />
  </joint>

  <joint name="Joint_5" type="revolute">
    <origin xyz="0 0 0.13" rpy="1.5708 0 0" />
    <parent link="Joint_4_Link" />
    <child link="Joint_5_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="3.6" velocity="6.2" />
  </joint>

  <joint name="Joint_6" type="revolute">
    <origin xyz="0 -0.07 0" rpy="-1.5708 0 0" />
    <parent link="Joint_5_Link" />
    <child link="Joint_6_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="3.6" velocity="6.8" />
  </joint>

  <joint name="Gripper_Mount" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <parent link="Joint_6_Link" />
    <child link="Gripper_Base_Link" />
  </joint>

  <joint name="Gripper_Joint_1" type="prismatic">
    <origin xyz="-0.015 0 0.03" rpy="0 0 0" />
    <parent link="Gripper_Base_Link" />
    <child link="Gripper_Joint_1_Link" />
    <axis xyz="1 0 0" />
    <limit lower="-0.05" upper="0.0" effort="3.5" velocity="2.52" />
  </joint>

  <!-- B4: Mimic joint - Gripper_Joint_2 her zaman Joint_1'in TERSİ olacak (paralel hareket) -->
  <joint name="Gripper_Joint_2" type="prismatic">
    <origin xyz="0.015 0 0.03" rpy="0 0 0" />
    <parent link="Gripper_Base_Link" />
    <child link="Gripper_Joint_2_Link" />
    <axis xyz="1 0 0" />
    <limit lower="0.0" upper="0.05" effort="3.5" velocity="2.5" />
    <mimic joint="Gripper_Joint_1" multiplier="-1" offset="0"/>
  </joint>

</robot>
