      <origin xyz="-9.4848E-08 -0.026788 0.046882" rpy="0 0 0" />
      <mass value="0.30694" />
      <inertia ixx="0.00069349" ixy="2.0353E-09" ixz="3.6028E-10"
               iyy="0.00077178" iyz="-1.5408E-05"
               izz="0.00045256" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arc_rover_autonomy/meshes/Joint_1_Link.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arc_rover_autonomy/meshes/Joint_1_Link.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="Joint_2_Link">
    <inertial>
      <origin xyz="-3.7664E-09 0.16038 0.0084295" rpy="0 0 0" />
      <mass value="0.4329" />
      <inertia ixx="0.005077" ixy="1.6233E-10" ixz="-2.0716E-11"
               iyy="0.00018875" iyz="-1.7202E-05"
               izz="0.0050389" />
