<?xml version="1.0" encoding="utf-8"?>
<!--
  LupusArm Kinematik Tanımı
  ==========================
  Bu dosya sadece robot kolun fiziksel/kinematik tanımını içerir:
  - Linkler (gövde parçaları)
  - Eklemler (joints) ve limitler
  - Eylemsizlik (inertia) bilgileri
  - Görsel mesh ve çarpışma geometrileri
  
  ros2_control ve Gazebo plugin tanımları AYRI dosyalarda (LupusArm.ros2_control.xacro).
  Bu sayede aynı kinematik hem Gazebo, hem mock hardware, hem gerçek robot için kullanılır.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="LupusArm">

  <!-- ============================================================ -->
  <!-- LINKLER                                                       -->
  <!-- ============================================================ -->

  <link name="base_link">
    <inertial>
      <origin xyz="3.0317E-12 -0.0078874 0.038799" rpy="0 0 0" />
      <mass value="0.21246" />
      <inertia ixx="0.00021564" ixy="-7.9173E-15" ixz="-2.7878E-15"
               iyy="0.00021581" iyz="2.5701E-05"
               izz="0.00038546" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arc_rover_autonomy/meshes/base_link.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arc_rover_autonomy/meshes/base_link.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="Joint_1_Link">
