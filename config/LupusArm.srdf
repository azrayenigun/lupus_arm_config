<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="LupusArm">
    <group name="arm">
        <joint name="Joint_1"/>
        <joint name="Joint_2"/>
        <joint name="Joint_3"/>
        <joint name="Joint_4"/>
        <joint name="Joint_5"/>
        <joint name="Joint_6"/>
    </group>
    <group name="gripper">
        <joint name="Gripper_Joint_1"/>
        <joint name="Gripper_Joint_2"/>
    </group>
    <group_state name="home" group="arm">
        <joint name="Joint_1" value="1.3185"/>
        <joint name="Joint_2" value="0"/>
        <joint name="Joint_3" value="0.1475"/>
        <joint name="Joint_4" value="0"/>
        <joint name="Joint_5" value="-0.26"/>
        <joint name="Joint_6" value="-0.0041"/>
    </group_state>
    <group_state name="ready" group="arm">
        <joint name="Joint_1" value="1.3"/>
        <joint name="Joint_2" value="-0.21"/>
        <joint name="Joint_3" value="0.212"/>
        <joint name="Joint_4" value="0"/>
        <joint name="Joint_5" value="-0.25"/>
        <joint name="Joint_6" value="-0.015"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="Gripper_Joint_1" value="-0.04"/>
        <joint name="Gripper_Joint_2" value="0.04"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="Gripper_Joint_1" value="0.0"/>
        <joint name="Gripper_Joint_2" value="0.0"/>
    </group_state>
    <group_state name="half_open" group="gripper">
        <joint name="Gripper_Joint_1" value="-0.02"/>
        <joint name="Gripper_Joint_2" value="0.02"/>
    </group_state>

    <end_effector name="hand" parent_link="Gripper_Base_Link" group="gripper"/>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <disable_collisions link1="Gripper_Base_Link" link2="Gripper_Joint_1_Link" reason="Adjacent"/>
    <disable_collisions link1="Gripper_Base_Link" link2="Gripper_Joint_2_Link" reason="Adjacent"/>
    <disable_collisions link1="Gripper_Base_Link" link2="Joint_4_Link" reason="Default"/>
    <disable_collisions link1="Gripper_Base_Link" link2="Joint_5_Link" reason="Default"/>
    <disable_collisions link1="Gripper_Base_Link" link2="Joint_6_Link" reason="Adjacent"/>
    <disable_collisions link1="Gripper_Joint_1_Link" link2="Gripper_Joint_2_Link" reason="Never"/>
    <disable_collisions link1="Gripper_Joint_1_Link" link2="Joint_5_Link" reason="Never"/>
    <disable_collisions link1="Gripper_Joint_1_Link" link2="Joint_6_Link" reason="Never"/>
    <disable_collisions link1="Gripper_Joint_2_Link" link2="Joint_5_Link" reason="Never"/>
    <disable_collisions link1="Gripper_Joint_2_Link" link2="Joint_6_Link" reason="Never"/>
    <disable_collisions link1="Joint_1_Link" link2="Joint_2_Link" reason="Adjacent"/>
    <disable_collisions link1="Joint_1_Link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="Joint_2_Link" link2="Joint_3_Link" reason="Adjacent"/>
    <disable_collisions link1="Joint_2_Link" link2="Joint_4_Link" reason="Never"/>
    <disable_collisions link1="Joint_2_Link" link2="Joint_5_Link" reason="Never"/>
    <disable_collisions link1="Joint_2_Link" link2="Joint_6_Link" reason="Never"/>
    <disable_collisions link1="Joint_3_Link" link2="Joint_4_Link" reason="Adjacent"/>
    <disable_collisions link1="Joint_3_Link" link2="Joint_5_Link" reason="Never"/>
    <disable_collisions link1="Joint_3_Link" link2="Joint_6_Link" reason="Never"/>
    <disable_collisions link1="Joint_4_Link" link2="Joint_5_Link" reason="Adjacent"/>
    <disable_collisions link1="Joint_4_Link" link2="Joint_6_Link" reason="Default"/>
    <disable_collisions link1="Joint_5_Link" link2="Joint_6_Link" reason="Adjacent"/>
</robot>
