# ros2_control controller manager configuration
# Mimic joint (Gripper_Joint_2) gripper_controller'da YOK, URDF'de tanimli

controller_manager:
  ros__parameters:
    update_rate: 100  # Hz

    arm_controller:
      type: joint_trajectory_controller/JointTrajectoryController

    gripper_controller:
      type: joint_trajectory_controller/JointTrajectoryController

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster


arm_controller:
  ros__parameters:
    joints:
      - Joint_1
      - Joint_2
      - Joint_3
      - Joint_4
      - Joint_5
      - Joint_6
    command_interfaces:
      - position
    state_interfaces:
      - position
      - velocity
    state_publish_rate: 50.0
    action_monitor_rate: 20.0
    allow_partial_joints_goal: false
    constraints:
      stopped_velocity_tolerance: 0.01
      goal_time: 0.5
      # B8: Hassas görevler için sıkı tolerans
      Joint_1: { trajectory: 0.1, goal: 0.05 }
      Joint_2: { trajectory: 0.1, goal: 0.05 }
      Joint_3: { trajectory: 0.1, goal: 0.05 }
      Joint_4: { trajectory: 0.05, goal: 0.02 }
      Joint_5: { trajectory: 0.05, goal: 0.02 }
      Joint_6: { trajectory: 0.05, goal: 0.02 }


gripper_controller:
  ros__parameters:
    joints:
      - Gripper_Joint_1
    command_interfaces:
      - position
    state_interfaces:
      - position
      - velocity
    allow_partial_joints_goal: false
    constraints:
      stopped_velocity_tolerance: 0.01
      goal_time: 0.5
      Gripper_Joint_1: { trajectory: 0.01, goal: 0.005 }
